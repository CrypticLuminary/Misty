# Local development only. Never commit real credentials.
POSTGRES_DB=misty
POSTGRES_USER=misty
POSTGRES_PASSWORD=misty-local-only
DATABASE_URL=postgresql://misty:misty-local-only@127.0.0.1:5432/misty

REDIS_URL=redis://127.0.0.1:6379/0

S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=misty-local
S3_ACCESS_KEY=misty-local
S3_SECRET_KEY=misty-local-only-change-me

RUST_LOG=misty_api=info,tower_http=info

MISTY_BIND_ADDR=127.0.0.1:8080
